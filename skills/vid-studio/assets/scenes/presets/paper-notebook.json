{
  "id": "paper-notebook",
  "name": "Paper Notebook",
  "description": "Ruled cream paper, pencil-dark ink and a terracotta pen, with no panels: just writing on the page. Handwritten headlines for study notes and how-tos.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#F2EBDD",
      "surface": "#FBF6EC",
      "text": "#2A251F",
      "muted": "#7E7466",
      "accent": "#C4461B",
      "accent2": "#2F6D8C",
      "negative": "#B23A2A"
    },
    "fonts": {
      "display": "Kalam",
      "body": "Mukta",
      "mono": "Space Mono"
    },
    "type": {
      "scale": 1.0,
      "display_case": "none",
      "display_weight": 700,
      "tracking": 0.0
    },
    "motion": {
      "energy": "calm",
      "easing": "smooth",
      "transition": "fade"
    },
    "captions": {
      "style": "highlight",
      "position": "lower",
      "highlight": "accent",
      "max_words": 5,
      "size": "medium"
    },
    "background": {
      "style": "paper",
      "pattern": "lines"
    },
    "surfaces": {
      "style": "flat"
    },
    "images": {
      "treatment": "natural",
      "layout": "auto"
    },
    "sources": {
      "show": true
    },
    "progress": {
      "show": true
    },
    "radius": 6,
    "logo": {
      "text": "",
      "position": "top-left"
    },
    "custom_css": ""
  }
}
