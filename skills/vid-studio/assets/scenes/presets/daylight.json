{
  "id": "daylight",
  "name": "Daylight",
  "description": "Cool daylight grey, crisp white glass, ink type and one vivid orange. Geist headlines and glass captions, for bright, modern explainers that look shot in a studio.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#ECEEF2",
      "surface": "#FFFFFF",
      "text": "#0D1016",
      "muted": "#5F6775",
      "accent": "#F2541B",
      "accent2": "#3A73FF",
      "negative": "#D93A3A"
    },
    "fonts": {
      "display": "Geist",
      "body": "Mukta",
      "mono": "JetBrains Mono"
    },
    "type": {
      "scale": 1.0,
      "display_case": "none",
      "display_weight": 700,
      "tracking": -0.04
    },
    "motion": {
      "energy": "medium",
      "easing": "snappy",
      "transition": "slide"
    },
    "captions": {
      "style": "glass",
      "position": "lower",
      "highlight": "accent",
      "max_words": 4,
      "size": "medium"
    },
    "background": {
      "style": "ambient",
      "pattern": "none"
    },
    "surfaces": {
      "style": "glass"
    },
    "images": {
      "treatment": "natural",
      "layout": "auto"
    },
    "sources": {
      "show": true
    },
    "progress": {
      "show": true
    },
    "radius": 20,
    "logo": {
      "text": "",
      "position": "top-left"
    },
    "custom_css": ""
  }
}
