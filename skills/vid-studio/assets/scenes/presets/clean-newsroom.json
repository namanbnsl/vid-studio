{
  "id": "clean-newsroom",
  "name": "Broadsheet",
  "description": "Newsprint white, black serif headlines and a single editorial red. Square white panels, black-and-white photos and steady fades: the look of a front page.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#F6F4EF",
      "surface": "#FFFFFF",
      "text": "#121212",
      "muted": "#66625B",
      "accent": "#C8102E",
      "accent2": "#1D4E89",
      "negative": "#C8102E"
    },
    "fonts": {
      "display": "Fraunces",
      "body": "Hind",
      "mono": "IBM Plex Mono"
    },
    "type": {
      "scale": 1.0,
      "display_case": "none",
      "display_weight": 700,
      "tracking": -0.02
    },
    "motion": {
      "energy": "medium",
      "easing": "smooth",
      "transition": "fade"
    },
    "captions": {
      "style": "highlight",
      "position": "lower",
      "highlight": "accent",
      "max_words": 4,
      "size": "medium"
    },
    "background": {
      "style": "solid",
      "pattern": "none"
    },
    "surfaces": {
      "style": "solid"
    },
    "images": {
      "treatment": "mono",
      "layout": "auto"
    },
    "sources": {
      "show": true
    },
    "progress": {
      "show": true
    },
    "radius": 3,
    "logo": {
      "text": "",
      "position": "top-left"
    },
    "custom_css": ""
  }
}
