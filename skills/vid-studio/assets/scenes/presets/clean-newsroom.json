{
  "id": "clean-newsroom",
  "name": "Clean Newsroom",
  "description": "Light, editorial and restrained, like a business daily: warm newsprint, serif headlines, oxford-blue figures, boxed captions.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#FBF7F0",
      "surface": "#FFFFFF",
      "text": "#16130F",
      "muted": "#6A6258",
      "accent": "#0F5499",
      "accent2": "#C2410C",
      "negative": "#B42318"
    },
    "fonts": {
      "display": "Fraunces",
      "body": "Inter",
      "mono": "IBM Plex Mono"
    },
    "type": {
      "scale": 1.0,
      "display_case": "none",
      "display_weight": 600,
      "tracking": -0.02
    },
    "motion": {
      "energy": "calm",
      "easing": "smooth",
      "transition": "fade"
    },
    "captions": {
      "style": "boxed",
      "position": "lower",
      "highlight": "accent",
      "max_words": 6
    },
    "background": {
      "style": "solid",
      "pattern": "none"
    },
    "radius": 4,
    "logo": {
      "text": "",
      "position": "top-left"
    },
    "custom_css": ""
  }
}
