{
  "id": "chalk-bold",
  "name": "Chalkboard",
  "description": "Slate green, chalk white and a yellow stick of chalk. Rounded Baloo type that reads well in Hindi; a classroom that moves.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#1E2B25",
      "surface": "#26362E",
      "text": "#EEF0E6",
      "muted": "#9BAA9F",
      "accent": "#F5D76E",
      "accent2": "#8ED1C6",
      "negative": "#F08A7E"
    },
    "fonts": {
      "display": "Baloo 2",
      "body": "Baloo 2",
      "mono": "Space Mono"
    },
    "type": {
      "scale": 1.0,
      "display_case": "none",
      "display_weight": 800,
      "tracking": -0.01
    },
    "motion": {
      "energy": "medium",
      "easing": "bouncy",
      "transition": "slide"
    },
    "captions": {
      "style": "highlight",
      "position": "lower",
      "highlight": "accent",
      "max_words": 4,
      "size": "medium"
    },
    "background": {
      "style": "aura",
      "pattern": "none"
    },
    "cards": {
      "style": "glass"
    },
    "images": {
      "treatment": "dim"
    },
    "sources": {
      "show": true
    },
    "progress": {
