{
  "id": "calm-minimal",
  "name": "Calm Minimal",
  "description": "Oat paper, ink and one deep green. A quiet serif, slow fades and lots of air, for considered explainers.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#F3F0EA",
      "surface": "#FFFFFF",
      "text": "#1C1B19",
      "muted": "#75716A",
      "accent": "#2E6B5A",
      "accent2": "#C77D3A",
      "negative": "#B5483C"
    },
    "fonts": {
      "display": "Instrument Serif",
      "body": "Hind",
      "mono": "IBM Plex Mono"
    },
    "type": {
      "scale": 1.05,
      "display_case": "none",
      "display_weight": 400,
      "tracking": -0.01
    },
    "motion": {
      "energy": "calm",
      "easing": "smooth",
      "transition": "fade"
    },
    "captions": {
      "style": "underline",
      "position": "lower",
      "highlight": "accent",
      "max_words": 5,
      "size": "medium"
    },
    "background": {
      "style": "solid",
      "pattern": "none"
    },
    "images": {
      "treatment": "natural"
    },
    "sources": {
      "show": true
    },
    "progress": {
      "show": true
    },
    "radius": 6,
    "logo": {
      "text": "",
      "position": "top-left"
    },
    "custom_css": ""
  }
}
