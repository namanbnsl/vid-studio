{
  "id": "data-noir",
  "name": "Data Noir",
  "description": "Black, white and one vermilion. Tight grotesque numbers and hard cuts, for markets and tech where the chart is the story.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#0B0B0C",
      "surface": "#17171A",
      "text": "#ECECEC",
      "muted": "#808086",
      "accent": "#FF4F2E",
      "accent2": "#F2F2F2",
      "negative": "#FF4F2E"
    },
    "fonts": {
      "display": "Space Grotesk",
      "body": "Mukta",
      "mono": "IBM Plex Mono"
    },
    "type": {
      "scale": 1.0,
      "display_case": "none",
      "display_weight": 700,
      "tracking": -0.03
    },
    "motion": {
      "energy": "medium",
      "easing": "snappy",
      "transition": "cut"
    },
    "captions": {
      "style": "highlight",
      "position": "lower",
      "highlight": "accent",
      "max_words": 4,
      "size": "medium"
    },
    "background": {
      "style": "solid",
      "pattern": "none"
    },
    "cards": {
      "style": "glass"
    },
    "images": {
      "treatment": "mono"
    },
    "sources": {
      "show": true
    },
    "progress": {
      "show": true
    },
    "radius": 22,
    "logo": {
      "text": "",
      "position": "top-left"
    },
    "custom_css": ""
  }
}
