{
  "id": "neon-finance",
  "name": "Night Desk",
  "description": "Midnight navy, mint numbers and an amber second colour, on frosted panels under a cool light. Squared Rajdhani headlines with full Devanagari support: the default for Hindi and Hinglish.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#0A1222",
      "surface": "#121C33",
      "text": "#EAF1FF",
      "muted": "#8A9AB8",
      "accent": "#3DE0C8",
      "accent2": "#FFB547",
      "negative": "#FF5C7A"
    },
    "fonts": {
      "display": "Rajdhani",
      "body": "Hind",
      "mono": "Khand"
    },
    "type": {
      "scale": 1.0,
      "display_case": "none",
      "display_weight": 700,
      "tracking": 0.0
    },
    "motion": {
      "energy": "high",
      "easing": "snappy",
      "transition": "slide"
    },
    "captions": {
      "style": "highlight",
      "position": "lower",
      "highlight": "accent",
      "max_words": 4,
      "size": "medium"
    },
    "background": {
      "style": "ambient",
      "pattern": "none"
    },
    "surfaces": {
      "style": "glass"
    },
    "images": {
      "treatment": "dim",
      "layout": "auto"
    },
    "sources": {
      "show": true
    },
    "progress": {
      "show": true
    },
    "radius": 16,
    "logo": {
      "text": "",
      "position": "top-left"
    },
    "custom_css": ""
  }
}
