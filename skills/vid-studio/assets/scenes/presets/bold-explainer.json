{
  "id": "bold-explainer",
  "name": "Bold Explainer",
  "description": "Warm charcoal, marigold numbers and a characterful grotesque. Frosted glass panels over a soft warm light, photos framed like a magazine. Fast and confident, built for Shorts that explain one thing.",
  "design": {
    "aspect": "9:16",
    "colors": {
      "background": "#121110",
      "surface": "#1D1B19",
      "text": "#F7F3EA",
      "muted": "#9C978D",
      "accent": "#FFC233",
      "accent2": "#FF7A45",
      "negative": "#FF5D5D"
    },
    "fonts": {
      "display": "Bricolage Grotesque",
      "body": "Mukta",
      "mono": "JetBrains Mono"
    },
    "type": {
      "scale": 1.0,
      "display_case": "none",
      "display_weight": 800,
      "tracking": -0.03
    },
    "motion": {
      "energy": "high",
      "easing": "snappy",
      "transition": "slide"
    },
    "captions": {
      "style": "highlight",
      "position": "lower",
      "highlight": "accent",
      "max_words": 4,
      "size": "medium"
    },
    "background": {
      "style": "ambient",
      "pattern": "none"
    },
    "surfaces": {
      "style": "glass"
    },
    "images": {
      "treatment": "dim",
      "layout": "auto"
    },
    "sources": {
      "show": true
    },
    "progress": {
      "show": true
    },
    "radius": 16,
    "logo": {
      "text": "",
      "position": "top-left"
    },
    "custom_css": ""
  }
}
